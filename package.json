{
  "name": "concierge-chat-widget",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Concierge - an embeddable, framework-free AI support chat widget with an offline knowledge-base engine.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && vite build -c vite.widget.config.ts",
    "build:widget": "vite build -c vite.widget.config.ts",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest",
    "size": "node scripts/size.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@types/node": "22.9.0",
    "eslint": "9.15.0",
    "eslint-config-prettier": "9.1.0",
    "globals": "15.12.0",
    "jsdom": "25.0.1",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  }
}
